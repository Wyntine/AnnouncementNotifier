{
  "name": "announcement-notifier",
  "version": "1.2.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.mjs",
    "dev": "tsx src/index.ts",
    "build": "tsdown",
    "prebuild": "run-s lint",
    "prepack": "run-s lint build",
    "lint": "run-s typeCheck eslint format",
    "eslint": "eslint --fix ./src",
    "typeCheck": "tsc --noEmit",
    "format": "prettier -w ."
  },
  "keywords": [
    "announcement",
    "tracker",
    "typescript",
    "wyntine"
  ],
  "author": "Wyntine",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@wyntine/prettier-config": "^1.1.1",
    "npm-run-all": "^4.1.5",
    "prettier-eslint": "^17.1.2",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "@types/html-to-text": "^9.0.4",
    "cheerio": "^1.2.0",
    "html-to-text": "^10.0.1",
    "tsx": "^4.23.15",
    "undici": "^8.12.4",
    "ws": "^8.22.2",
    "yaml": "^2.9.1"
  },
  "prettier": "@wyntine/prettier-config",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "homepage": "https://github.com/Wyntine/AnnouncementNotifier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wyntine/AnnouncementNotifier.git"
  },
  "bugs": {
    "url": "https://github.com/Wyntine/AnnouncementNotifier/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
