{
  "name": "announcement-notifier",
  "version": "1.2.0",
  "description": "A backend to fetch school notifications and send them.",
  "main": "dist/index.mjs",
  "type": "module",
  "scripts": {
    "start": "node dist/index.mjs",
    "dev": "tsx src/index.ts",
    "test": "tsx src/test.ts",
    "build": "tsdown",
    "prebuild": "run-s lint",
    "prepack": "run-s lint build",
    "lint": "run-s typeCheck eslint format",
    "eslint": "eslint --fix ./src ./scripts",
    "typeCheck": "tsc --noEmit && tsc --noEmit -p ./scripts/tsconfig.json",
    "format": "tsx scripts/lint.ts format --write .",
    "check": "tsx scripts/lint.ts check .",
    "postinstall": "tsx scripts/symlink-biome.ts"
  },
  "keywords": [
    "announcement",
    "tracker",
    "typescript",
    "wyntine"
  ],
  "author": "Wyntine",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@eslint/js": "^10.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "npm-run-all": "^4.1.5",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "html-to-text": "^10.0.1",
    "undici": "^8.12.4",
    "ws": "^8.22.2",
    "yaml": "^2.9.1"
  },
  "exports": {
    ".": {
      "require": "./dist/index.mjs",
      "import": "./dist/index.mjs"
    }
  },
  "homepage": "https://github.com/Wyntine/AnnouncementNotifier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wyntine/AnnouncementNotifier.git"
  },
  "bugs": {
    "url": "https://github.com/Wyntine/AnnouncementNotifier/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
